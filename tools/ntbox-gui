ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
NTSHELL = os.path.join(ROOT, "tools", "ntshell", "ntshell")
NTBOX_KO = os.path.join(ROOT, "ntbox.ko")
