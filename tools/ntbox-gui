    def on_pick_exe(self, _):
        self._pick(self.run_entry, "Select .exe", "*.exe")

    def on_pick_user(self, _):
        self._pick(self.user_entry, "Select .exe", "*.exe")

    def on_pick_sys(self, _):
        self._pick(self.sys_entry, "Select .sys", "*.sys")

    def _pick(self, entry, title, pattern):
        dlg = Gtk.FileChooserDialog(title=title, transient_for=self, action=Gtk.FileChooserAction.OPEN)
        dlg.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL, Gtk.STOCK_OPEN, Gtk.ResponseType.OK)
        f = Gtk.FileFilter()
        f.set_name(pattern)
        f.add_pattern(pattern)
        dlg.add_filter(f)
        if dlg.run() == Gtk.ResponseType.OK:
            entry.set_text(dlg.get_filename())
        dlg.destroy()

    def on_ntshell(self, _, cmd, lamp=None):
        self._run_async(self._ntshell, cmd, self.run_log.append, lamp)

    def _ntshell(self, cmd, log_cb=None, lamp=None):
        log_cb = log_cb or self.run_log.append
        full = [NTSHELL] + cmd
        GLib.idle_add(log_cb, "$ " + " ".join(full))
        op = cmd[0]
        if lamp:
            self.lamp_ids[op] = self.lamp_ids.get(op, 0) + 1
            GLib.idle_add(lamp.set_run, self.lamp_ids[op])
        try:
            p = subprocess.Popen(full, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
            for line in p.stdout:
                GLib.idle_add(log_cb, line.rstrip())
            p.wait()
            GLib.idle_add(log_cb, "exit=%d" % p.returncode)
            if lamp:
                GLib.idle_add(lamp.set_ok if p.returncode == 0 else lamp.set_fail)
        except Exception as e:
            GLib.idle_add(log_cb, "ERR: %s" % e)
            if lamp:
                GLib.idle_add(lamp.set_fail)

    def on_runexe(self, _):
        path = self.run_entry.get_text().strip()
        if not path:
            self.run_log.append("!! Enter path to .exe")
            return
        self._run_async(self._ntshell, ["runexe", path], self.run_log.append, self.lamps["runexe"])

    def on_runuser(self, _):
        path = self.user_entry.get_text().strip()
        if not path:
            self.run_log.append("!! Enter path to .exe")
            return
        self._run_async(self._ntshell, ["runuser", path], self.run_log.append, self.lamps["runuser"])

