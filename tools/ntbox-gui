CONFIG_DIR = os.path.expanduser("~/.config/ntbox")
SHORTCUTS_FILE = os.path.join(CONFIG_DIR, "shortcuts.json")


def run_sudo(cmd, password=None, log_cb=None):
    if log_cb is None:
        log_cb = lambda x: None
    if password:
        p = subprocess.Popen(["sudo", "-S"] + cmd, stdin=subprocess.PIPE,
                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        try:
            p.stdin.write(password + "\n")
            p.stdin.close()
        except Exception:
            pass
    else:
        p = subprocess.Popen(["sudo", "-n"] + cmd, stdout=subprocess.PIPE,
                             stderr=subprocess.STDOUT, text=True)
    try:
        for line in p.stdout:
            GLib.idle_add(log_cb, line.rstrip())
    except Exception:
        pass
    p.wait()
    return p.returncode


def is_ntbox_loaded():
    try:
        with open("/proc/modules") as f:
            if "ntbox" in f.read():
                return True
    except Exception:
        pass
    try:
        out = subprocess.check_output(["lsmod"], stderr=subprocess.DEVNULL, text=True)
        if "ntbox" in out:
            return True
    except Exception:
        pass
    return False


class LogView(Gtk.ScrolledWindow):
    def __init__(self):
        super().__init__()
        self.tv = Gtk.TextView()
        self.tv.set_editable(False)
        self.tv.set_monospace(True)
        self.add(self.tv)
        self.buf = self.tv.get_buffer()

    def append(self, msg):
        try:
            self.buf.insert(self.buf.get_end_iter(), str(msg) + "\n")
            mark = self.buf.create_mark(None, self.buf.get_end_iter(), False)
            self.tv.scroll_to_mark(mark, 0.0, True, 0.0, 1.0)
        except Exception:
            pass


class Lamp(Gtk.Box):
    def __init__(self, op):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.current_id = 0
        self.state = "idle"
        self.dot = Gtk.DrawingArea()
        self.dot.set_size_request(16, 16)
        self.dot.connect("draw", self._on_draw)
        self.pack_start(self.dot, False, False, 0)
        self.label = Gtk.Label(label="[ntbox][0][--]")
        self.label.set_xalign(0)
        self.pack_start(self.label, False, False, 0)

    def _on_draw(self, widget, cr):
        alloc = widget.get_allocation()
        size = min(alloc.width, alloc.height)
        cx = alloc.width / 2.0
        cy = alloc.height / 2.0
        r = max(size / 2.0 - 2, 2)
        cr.arc(cx, cy, r, 0, 2 * 3.14159265)
        if self.state == "ok":
            cr.set_source_rgb(0.15, 0.75, 0.15)
        elif self.state == "fail":
            cr.set_source_rgb(0.9, 0.2, 0.2)
        elif self.state == "run":
            cr.set_source_rgb(0.9, 0.75, 0.1)
        else:
            cr.set_source_rgb(0.55, 0.55, 0.55)
        cr.fill()
        return False

    def _refresh(self):
        self.label.set_text("[ntbox][%d][%s]" % (self.current_id, {"idle": "--", "run": "RUN", "ok": "OK", "fail": "FAIL"}[self.state]))
        self.dot.queue_draw()

    def set_idle(self, id_):
        self.current_id = id_
        self.state = "idle"
        self._refresh()

    def set_run(self, id_):
        self.current_id = id_
        self.state = "run"
        self._refresh()

    def set_ok(self):
        self.state = "ok"
        self._refresh()

    def set_fail(self):
        self.state = "fail"
        self._refresh()


class NTBoxGUI(Gtk.Window):
    def __init__(self):
        super().__init__(title="NT-Box Control Panel")
        self.set_default_size(1100, 750)
        self.set_border_width(6)

        self.shortcuts = self._load_shortcuts()
        self.ops = ["selftest", "partitions", "result", "stats", "runexe", "runuser", "loadsys", "gpu", "runtime"]
        self.lamp_ids = {op: 0 for op in self.ops}
        self.lamps = {}

        self._check_and_load_kernel_module()

        nb = Gtk.Notebook()
        self.add(nb)

        nb.append_page(self._build_run_tab(), Gtk.Label(label="Run EXE/Games"))
        nb.append_page(self._build_part_tab(), Gtk.Label(label="Partitions/Drives"))
        nb.append_page(self._build_gpu_tab(), Gtk.Label(label="GPU Drivers"))
        nb.append_page(self._build_runtime_tab(), Gtk.Label(label="Runtimes/Installers"))
        nb.append_page(self._build_files_tab(), Gtk.Label(label="File Explorer"))
        nb.append_page(self._build_groups_tab(), Gtk.Label(label="Shortcuts & Categories"))

        self.show_all()

    def _check_and_load_kernel_module(self):
        if is_ntbox_loaded():
            return
        if os.path.exists(NTBOX_KO):
            pw = self.ask_password("ntbox.ko not loaded.\nEnter sudo password to load automatically (insmod):")
            if pw is not None:
                cmd = ["insmod", NTBOX_KO]
                run_sudo(cmd, pw, lambda m: None)

    def _load_shortcuts(self):
        try:
            os.makedirs(CONFIG_DIR, exist_ok=True)
            if os.path.exists(SHORTCUTS_FILE):
                with open(SHORTCUTS_FILE) as f:
                    return json.load(f)
        except Exception:
            pass
        return {"Games": [], "Steam": [], "Applications": [], "Runtimes": []}

    def _save_shortcuts(self):
        try:
            os.makedirs(CONFIG_DIR, exist_ok=True)
            with open(SHORTCUTS_FILE, "w") as f:
                json.dump(self.shortcuts, f, indent=2, ensure_ascii=False)
        except Exception:
            pass

    def _run_async(self, fn, *a, **k):
        threading.Thread(target=fn, args=a, kwargs=k, daemon=True).start()

    def ask_password(self, prompt="NT-Box requires root privileges.\nEnter sudo password:"):
        dlg = Gtk.Dialog(title="Root Privileges", transient_for=self, flags=0)
        dlg.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL, Gtk.STOCK_OK, Gtk.ResponseType.OK)
        box = dlg.get_content_area()
        box.set_spacing(6)
        box.set_border_width(8)
        box.pack_start(Gtk.Label(label=prompt), False, False, 0)
        ent = Gtk.Entry()
        ent.set_visibility(False)
        box.pack_start(ent, False, False, 0)
        dlg.show_all()
        resp = dlg.run()
        pw = ent.get_text() if resp == Gtk.ResponseType.OK else None
        dlg.destroy()
        return pw

