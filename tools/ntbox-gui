    def on_test_gpu(self, _):
        gpu_bin = os.path.join(ROOT, "tools", "ntboxgpu", "ntboxgpu")
        if not os.path.exists(gpu_bin):
            self.gpu_log.append("!! ntboxgpu not built. Run 'make' in project root.")
            return
        self.gpu_log.append("==> Running ntboxgpu test...")
        def run_g():
            try:
                p = subprocess.Popen([gpu_bin], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
                for line in p.stdout:
                    GLib.idle_add(self.gpu_log.append, line.rstrip())
                p.wait()
                GLib.idle_add(self.gpu_log.append, "ntboxgpu exit=%d" % p.returncode)
            except Exception as e:
                GLib.idle_add(self.gpu_log.append, "ERR: %s" % e)
        self._run_async(run_g)


