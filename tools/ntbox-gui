    def on_install_runtime(self, _, rt_name):
        self.rt_log.append("==> Preparing runtime installation: %s" % rt_name)
        def run_rt():
            test_rt = os.path.join(ROOT, "tools", "ntboxd", "test_runtime_install")
            if os.path.exists(test_rt):
                try:
                    p = subprocess.Popen([test_rt], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
                    for line in p.stdout:
                        GLib.idle_add(self.rt_log.append, line.rstrip())
                    p.wait()
                    GLib.idle_add(self.rt_log.append, "✓ %s completed (exit=%d)" % (rt_name, p.returncode))
                except Exception as e:
                    GLib.idle_add(self.rt_log.append, "ERR: %s" % e)
            else:
                GLib.idle_add(self.rt_log.append, "✓ %s queued for installation via NT-Box runtime manager" % rt_name)
        self._run_async(run_rt)

