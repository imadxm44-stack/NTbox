        b.connect("clicked", self.on_files_up)
        row.pack_start(b, False, False, 0)

        self.files_store = Gtk.ListStore(str, str, str)
        tv = Gtk.TreeView(model=self.files_store)
        cr = Gtk.CellRendererPixbuf()
        tv.append_column(Gtk.TreeViewColumn("Icon", cr, icon_name=0))
        tv.append_column(Gtk.TreeViewColumn("Name", Gtk.CellRendererText(), text=1))
        sw = Gtk.ScrolledWindow()
        sw.set_size_request(-1, 300)
        sw.add(tv)
        box.pack_start(sw, True, True, 0)
        tv.connect("row-activated", self.on_file_activated)

        self.files_log = LogView()
        box.pack_start(self.files_log, True, True, 0)
        GLib.idle_add(self.on_files_open, None)
        return box

    def on_files_open(self, _):
        path = self.files_path.get_text().strip()
        if not os.path.isdir(path):
            self.files_log.append("!! Directory not found: %s" % path)
            return
        self.files_store.clear()
        try:
            for name in sorted(os.listdir(path)):
                full = os.path.join(path, name)
                icon = "folder" if os.path.isdir(full) else "application-x-executable"
                self.files_store.append([icon, name, full])
            self.files_log.append("✓ Listed %d items in %s" % (len(self.files_store), path))
        except Exception as e:
            self.files_log.append("ERR: %s" % e)

    def on_files_up(self, _):
        path = self.files_path.get_text().strip()
        parent = os.path.dirname(path)
        if parent and parent != path:
            self.files_path.set_text(parent)
            self.on_files_open(None)

    def on_file_activated(self, tv, path, col):
        model = tv.get_model()
        it = model.get_iter(path)
        full = model.get_value(it, 2)
        name = model.get_value(it, 1)
        if os.path.isdir(full):
            self.files_path.set_text(full)
            self.on_files_open(None)
            return
        if name.lower().endswith('.exe'):
            self.files_log.append("Running in NT-Box: %s" % full)
            self._run_async(self._ntshell, ["runexe", full], self.files_log.append)
        else:
            self.files_log.append("Selected: %s" % full)


    def _build_groups_tab(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_border_width(8)
        info = Gtk.Label(label="Shortcuts & Categories Manager - Pin .exe/files to categories (Games, Steam, etc.) without duplicating files. Saved to ~/.config/ntbox/shortcuts.json")
        info.set_line_wrap(True)
        box.pack_start(info, False, False, 0)

        row = Gtk.Box(spacing=6)
        box.pack_start(row, False, False, 0)
        self.group_name_entry = Gtk.Entry()
        self.group_name_entry.set_placeholder_text("New category name (e.g., Games, Steam, Tools)")
        row.pack_start(self.group_name_entry, True, True, 0)
        b = Gtk.Button(label="Create Category")
        b.connect("clicked", self.on_group_create)
        row.pack_start(b, False, False, 0)
        b = Gtk.Button(label="Add .exe Shortcut")
        b.connect("clicked", self.on_group_add_shortcut)
        row.pack_start(b, False, False, 0)
        b = Gtk.Button(label="Run Selected")
        b.connect("clicked", self.on_shortcut_run)
        row.pack_start(b, False, False, 0)
        b = Gtk.Button(label="Delete Shortcut")
        b.connect("clicked", self.on_shortcut_delete)
        row.pack_start(b, False, False, 0)

        self.groups_store = Gtk.ListStore(str, str, str)
        self.groups_tv = Gtk.TreeView(model=self.groups_store)
        self.groups_tv.append_column(Gtk.TreeViewColumn("Category", Gtk.CellRendererText(), text=0))
        self.groups_tv.append_column(Gtk.TreeViewColumn("Name", Gtk.CellRendererText(), text=1))
        self.groups_tv.append_column(Gtk.TreeViewColumn("Path", Gtk.CellRendererText(), text=2))

        sw = Gtk.ScrolledWindow()
        sw.set_size_request(-1, 250)
        sw.add(self.groups_tv)
        box.pack_start(sw, True, True, 0)
        self.groups_tv.connect("row-activated", self.on_shortcut_run_activated)

        self._refresh_groups_store()

        self.groups_log = LogView()
        box.pack_start(self.groups_log, True, True, 0)
        return box

    def _refresh_groups_store(self):
        self.groups_store.clear()
        for g, items in self.shortcuts.items():
            for it in items:
                self.groups_store.append([g, it.get("label", ""), it.get("path", "")])

    def on_group_create(self, _):
        name = self.group_name_entry.get_text().strip()
        if not name:
            self.groups_log.append("!! Enter category name")
            return
        if name not in self.shortcuts:
            self.shortcuts[name] = []
            self._save_shortcuts()
            self._refresh_groups_store()
            self.groups_log.append("✓ Created category: %s" % name)
        else:
            self.groups_log.append("!! Category already exists")

    def on_group_add_shortcut(self, _):
        dlg = Gtk.FileChooserDialog(title="Select .exe to pin as shortcut", transient_for=self, action=Gtk.FileChooserAction.OPEN)
        dlg.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL, Gtk.STOCK_OPEN, Gtk.ResponseType.OK)
        f = Gtk.FileFilter()
        f.set_name("Executables (*.exe)")
        f.add_pattern("*.exe")
        dlg.add_filter(f)
        if dlg.run() != Gtk.ResponseType.OK:
            dlg.destroy()
            return
        path = dlg.get_filename()
        dlg.destroy()

        groups = list(self.shortcuts.keys())
        if not groups:
            self.shortcuts["Games"] = []
            groups = ["Games"]
        gname = groups[0]
        label = os.path.basename(path)

        for item in self.shortcuts.get(gname, []):
            if item.get("path") == path:
                self.groups_log.append("!! Shortcut already exists")
                return

        self.shortcuts[gname].append({"label": label, "path": path})
        self._save_shortcuts()
        self._refresh_groups_store()
        self.groups_log.append("✓ Added '%s' to category '%s'" % (label, gname))

    def on_shortcut_run(self, _):
        sel = self.groups_tv.get_selection()
        model, it = sel.get_selected()
        if not it:
            self.groups_log.append("!! Select a shortcut to run")
            return
        path = model.get_value(it, 2)
        if not path or not os.path.exists(path):
            self.groups_log.append("!! Invalid path: %s" % path)
            return
        self.groups_log.append("Running shortcut in NT-Box: %s" % path)
        self._run_async(self._ntshell, ["runexe", path], self.groups_log.append)

    def on_shortcut_run_activated(self, tv, path, col):
        model = tv.get_model()
        it = model.get_iter(path)
        fpath = model.get_value(it, 2)
        if fpath and os.path.exists(fpath):
            self.groups_log.append("Running (double-click): %s" % fpath)
            self._run_async(self._ntshell, ["runexe", fpath], self.groups_log.append)

    def on_shortcut_delete(self, _):
        sel = self.groups_tv.get_selection()
        model, it = sel.get_selected()
        if not it:
            self.groups_log.append("!! Select a shortcut to delete")
            return
        gname = model.get_value(it, 0)
        label = model.get_value(it, 1)
        path = model.get_value(it, 2)

        if gname in self.shortcuts:
            self.shortcuts[gname] = [item for item in self.shortcuts[gname] if item.get("path") != path]
            self._save_shortcuts()
            self._refresh_groups_store()
            self.groups_log.append("✓ Deleted shortcut '%s'" % label)


if __name__ == "__main__":
    win = NTBoxGUI()
    win.connect("destroy", Gtk.main_quit)
    Gtk.main()
