    def on_pick_part_dir(self, _):
        dlg = Gtk.FileChooserDialog(title="Select directory or device", transient_for=self, action=Gtk.FileChooserAction.SELECT_FOLDER)
        dlg.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL, Gtk.STOCK_OPEN, Gtk.ResponseType.OK)
        if dlg.run() == Gtk.ResponseType.OK:
            self.part_entry.set_text(dlg.get_filename())
        dlg.destroy()

    def on_attach(self, _):
        path = self.part_entry.get_text().strip()
        if not path:
            self.part_log.append("!! Enter path/device")
            return
        letter = chr(ord("D") + len(self.part_list))
        if len(self.part_list) > 22:
            letter = "Z"
        pw = self.ask_password("NT-Box needs root to attach drive.\nEnter sudo password:")
        if pw is None:
            self.part_log.append("!! Cancelled")
            return
        self._run_async(self._attach, path, letter, pw)

    def _attach(self, path, letter, pw):
        cmd = [NTSHELL, "attach", path, letter, path]
        rc = run_sudo(cmd, pw, self.part_log.append)
        if rc == 0:
            GLib.idle_add(self.part_list.append, [letter + ":", path])
            GLib.idle_add(self.part_log.append, "✓ attached %s as %s" % (path, letter + ":"))
        else:
            GLib.idle_add(self.part_log.append, "✗ attach failed (exit=%d)" % rc)

    def on_detach(self, _):
        if len(self.part_list) == 0:
            self.part_log.append("!! No drives attached")
            return
        last = self.part_list[-1]
        letter = last[0].rstrip(":")
        pw = self.ask_password("NT-Box needs root to detach drive.\nEnter sudo password:")
        if pw is None:
            self.part_log.append("!! Cancelled")
            return
        self._run_async(self._detach, letter, pw)

    def _detach(self, letter, pw):
        cmd = [NTSHELL, "detach", letter]
        rc = run_sudo(cmd, pw, self.part_log.append)
        if rc == 0:
            GLib.idle_add(self._remove_part, letter + ":")
            GLib.idle_add(self.part_log.append, "✓ detached %s" % letter)
        else:
            GLib.idle_add(self.part_log.append, "✗ detach failed (exit=%d)" % rc)

    def _remove_part(self, letter):
        for row in self.part_list:
            if row[0] == letter:
                self.part_list.remove(row.iter)
                break


