/* ExpandEnvironmentStringsA — return input string as-is */
DWORD __attribute__((ms_abi)) ntboxd_ExpandEnvironmentStringsA(
    LPCSTR lpSrc,
    LPSTR lpDst,
    DWORD nSize)
{
    size_t len = lpSrc ? strlen(lpSrc) : 0;
    fprintf(stderr, "[stub] ExpandEnvironmentStringsA(\"%s\", %p, %u) -> %zu\n",
            lpSrc ? lpSrc : "", lpDst, nSize, len + 1);
    if (lpDst && nSize > len)
        strcpy(lpDst, lpSrc ? lpSrc : "");
    return (DWORD)(len + 1);
}

