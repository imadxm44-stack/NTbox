/* LocalAlloc — allocate from system malloc */
LPVOID __attribute__((ms_abi)) ntboxd_LocalAlloc(UINT uFlags, SIZE_T uBytes)
{
    LPVOID p = malloc(uBytes);
    fprintf(stderr, "[stub] LocalAlloc(flags=0x%x, size=%zu) -> %p\n", uFlags, uBytes, p);
    return p;
}

/* LocalFree — free local allocation */
LPVOID __attribute__((ms_abi)) ntboxd_LocalFree(LPVOID hMem)
{
    fprintf(stderr, "[stub] LocalFree(%p)\n", hMem);
    if (hMem)
        free(hMem);
    return NULL;
}

/* LocalReAlloc — realloc local memory */
LPVOID __attribute__((ms_abi)) ntboxd_LocalReAlloc(LPVOID hMem, SIZE_T uBytes, UINT uFlags)
{
    LPVOID old_ptr = hMem;
    LPVOID p = realloc(hMem, uBytes);
    fprintf(stderr, "[stub] LocalReAlloc(%p, %zu, 0x%x) -> %p\n", old_ptr, uBytes, uFlags, p);
    return p;
}

/* LocalSize — return size (dummy) */
SIZE_T __attribute__((ms_abi)) ntboxd_LocalSize(LPVOID hMem)
{
    fprintf(stderr, "[stub] LocalSize(%p) -> 0x1000\n", hMem);
    return 0x1000;
}

