/* DuplicateHandle — return new pseudo-handle */
BOOL __attribute__((ms_abi)) ntboxd_DuplicateHandle(
    HANDLE hSourceProcessHandle,
    HANDLE hSourceHandle,
    HANDLE hTargetProcessHandle,
    LPVOID lpTargetHandle,
    DWORD dwDesiredAccess,
    BOOL bInheritHandle,
    DWORD dwOptions)
{
    fprintf(stderr, "[stub] DuplicateHandle(...)\n");
    if (lpTargetHandle) {
        HANDLE *p = (HANDLE *)lpTargetHandle;
        *p = make_pseudo_handle();
    }
    return 1;
}

