/*
 * api_stubs.c — Comprehensive Win32 API stubs for common unresolved imports.
 * 
 * Implements 50+ commonly-unresolved APIs from kernel32, kernelbase, advapi32.
 * Each stub:
 *   - Logs its invocation via stderr
 *   - Returns sensible defaults (non-null handles, valid counts, etc.)
 *   - Never crashes/segfaults
 *
 * Stubs organized by category:
 *   - Process Management
 *   - Memory Management
 *   - Thread Management
 *   - Handle Management
 *   - Environment/Registry
 *   - File I/O
 *   - Event/Synchronization
 *   - DLL Loading
 *   - Error Handling
 *   - String Conversion
 *   - System Information
 */

#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <locale.h>
#include <time.h>
#include <unistd.h>
#include <sys/types.h>
#include <pthread.h>

/* Windows types */
typedef void      *HANDLE;
typedef void      *LPVOID;
typedef const void *LPCVOID;
typedef uint32_t   DWORD;
typedef uint16_t   WORD;
typedef uint16_t   USHORT;
typedef int        BOOL;
typedef uint32_t   UINT;
typedef uintptr_t  UINT_PTR;
typedef intptr_t   LONG_PTR;
typedef int32_t    LONG;
typedef uint64_t   ULONGLONG;
typedef const char *LPCSTR;
typedef const uint16_t *LPCWSTR;
typedef uint16_t   *LPWSTR;
typedef char       *LPSTR;
typedef size_t     SIZE_T;
typedef unsigned char BYTE;
typedef void      *PVOID;
typedef const void *PCVOID;

/* Handle constants */
#ifndef TRUE
#define TRUE 1
#endif
#ifndef FALSE
#define FALSE 0
#endif
#define INVALID_HANDLE_VALUE ((HANDLE)(LONG_PTR)-1)
#define NULL_HANDLE ((HANDLE)NULL)
#define PSEUDO_HANDLE_BASE 0x100000000ULL

/* Define a simple pseudo-handle generator */
static uint64_t g_pseudo_handle_counter = PSEUDO_HANDLE_BASE;

static HANDLE make_pseudo_handle(void)
{
    return (HANDLE)(g_pseudo_handle_counter++);
}

/* ====================================================================
 * PROCESS MANAGEMENT
 * ==================================================================== */

/* GetCurrentProcess — return pseudo-handle for current process */
HANDLE __attribute__((ms_abi)) ntboxd_GetCurrentProcess(void)
{
    fprintf(stderr, "[stub] GetCurrentProcess()\n");
    static HANDLE proc_handle = NULL;
    if (!proc_handle)
        proc_handle = make_pseudo_handle();
    return proc_handle;
}

/* GetCurrentProcessId — return current process ID */
DWORD __attribute__((ms_abi)) ntboxd_GetCurrentProcessId(void)
{
    DWORD pid = (DWORD)getpid();
    fprintf(stderr, "[stub] GetCurrentProcessId() -> 0x%x\n", pid);
    return pid;
}

/* GetExitCodeProcess — always return success status */
BOOL __attribute__((ms_abi)) ntboxd_GetExitCodeProcess(HANDLE hProcess, DWORD *lpExitCode)
{
    fprintf(stderr, "[stub] GetExitCodeProcess(%p, %p)\n", hProcess, lpExitCode);
    if (lpExitCode)
        *lpExitCode = 0;  /* success */
    return 1;
}

/* CreateProcessA — stub: return failure (process creation not supported) */
BOOL __attribute__((ms_abi)) ntboxd_CreateProcessA(
    LPCSTR lpApplicationName,
    LPSTR lpCommandLine,
    PVOID lpProcessAttributes,
    PVOID lpThreadAttributes,
    BOOL bInheritHandles,
    DWORD dwCreationFlags,
    LPVOID lpEnvironment,
    LPCSTR lpCurrentDirectory,
    PVOID lpStartupInfo,
    PVOID lpProcessInformation)
{
    fprintf(stderr, "[stub] CreateProcessA(\"%s\", \"%s\", ...) -> FAIL\n",
            lpApplicationName ? lpApplicationName : "",
            lpCommandLine ? lpCommandLine : "");
    return 0;  /* fail */
}

/* CreateProcessW — stub: return failure */
BOOL __attribute__((ms_abi)) ntboxd_CreateProcessW(
    LPCWSTR lpApplicationName,
    LPWSTR lpCommandLine,
    PVOID lpProcessAttributes,
    PVOID lpThreadAttributes,
    BOOL bInheritHandles,
    DWORD dwCreationFlags,
    LPVOID lpEnvironment,
    LPCWSTR lpCurrentDirectory,
    PVOID lpStartupInfo,
    PVOID lpProcessInformation)
{
    fprintf(stderr, "[stub] CreateProcessW(...) -> FAIL\n");
    return 0;
}

/* TerminateProcess — stub: log and return success */
BOOL __attribute__((ms_abi)) ntboxd_TerminateProcess(HANDLE hProcess, UINT uExitCode)
{
    fprintf(stderr, "[stub] TerminateProcess(%p, %u)\n", hProcess, uExitCode);
    return 1;
}

/* OpenProcess — return pseudo-handle */
HANDLE __attribute__((ms_abi)) ntboxd_OpenProcess(
    DWORD dwDesiredAccess,
    BOOL bInheritHandle,
    DWORD dwProcessId)
{
    fprintf(stderr, "[stub] OpenProcess(access=0x%x, inherit=%d, pid=0x%x) -> pseudo-handle\n",
            dwDesiredAccess, bInheritHandle, dwProcessId);
