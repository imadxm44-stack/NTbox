/*
 * _initterm — REAL CRT-initializer walker (upgraded from a no-op).
 * Walks the MinGW CRT initializer table [pfbegin, pfend) and calls every
 * non-NULL entry. NULL entries inside the table are terminators to skip.
 * Targets are guest (MS-x64) code with zero-arg void entry points, so an
 * ms_abi callee pointer is the ABI-correct way to invoke them.
 *
 * Safety valve: NTBOXD_INITTERM_NOCALL=1 disables the actual calls
 * (log-and-return mode) for diagnosing crashes during CRT init.
 * Wiring note: resolved by name elsewhere (ntboxd.c resolve() /
 * ntboxd_libc_lookup()) — see bare-name alias below.
 */
typedef void (__attribute__((ms_abi)) *ntboxd_crt_init_fn_t)(void);

void __attribute__((ms_abi)) ntboxd_msvcrt_initterm(ntboxd_crt_init_fn_t *pfbegin,
                                                    ntboxd_crt_init_fn_t *pfend)
{
    ntboxd_crt_init_fn_t *p;
    int ncalls = 0;

    if (!pfbegin || !pfend || pfbegin >= pfend) {
        fprintf(stderr, "[stub] msvcrt._initterm(%p, %p) -> nothing to do\n",
                (void *)pfbegin, (void *)pfend);
        return;
    }

    if (getenv("NTBOXD_INITTERM_NOCALL")) {
        fprintf(stderr, "[stub] msvcrt._initterm(%p, %p) -> NOCALL mode, skipped\n",
                (void *)pfbegin, (void *)pfend);
        return;
    }

    for (p = pfbegin; p < pfend; p++) {
        if (*p) {          /* NULL = separator/terminator: skip, keep walking */
            (*p)();
            ncalls++;
        }
    }
    fprintf(stderr, "[stub] msvcrt._initterm(%p, %p) -> %d initializers called\n",
            (void *)pfbegin, (void *)pfend, ncalls);
}

void __attribute__((ms_abi)) ntboxd_msvcrt_amsg_exit(int r)
{
    /*
     * Upgraded: previously called exit(r) which killed the test process.
     * _amsg_exit signals a CRT internal error (low memory etc.) during
     * startup; logging and returning lets the CRT startup sequence
     * continue in the box (safer for tests than killing it).
     */
    fprintf(stderr, "[stub] msvcrt._amsg_exit(%d) -> ignored (logged only)\n", r);
}

/* ====================================================================
 * USER32 W-VARIANTS (UTF-16 -> ASCII passthrough, api_stubs-local)
 * ====================================================================
 *
 * NOTE FOR WIRING (owner: ntboxd.c resolve(), parallel agent):
 *   - RegisterClassW / CreateWindowExW / DefWindowProcW / MessageBoxW.
 *   - The A-variants (ntboxd_RegisterClassA, ntboxd_CreateWindowExA, ...)
 *     are *static* inside ntboxd.c, so api_stubs.c cannot link/delegate
 *     to them. These W-stubs therefore replicate the A-variant internal
 *     logic (including ntboxd_hwnd_t layout and its "WIND" magic) so
 *     windows created via the W path remain compatible with ntboxd.c's
 *     ShowWindow / GetClientRect / GetDC handling.
 *     If ntboxd.c's hwnd struct ever changes, keep this copy in sync.
 */

#define NTBOXD_HWND_MAGIC_W 0x57494E44UL   /* "WIND" — must match ntboxd.c */

typedef struct {
    unsigned long magic;                   /* NTBOXD_HWND_MAGIC_W */
    int width, height;
    const char *title;
    int shown;
} ntboxd_hwnd_w_t;

/* WNDCLASSW layout: style, lpfnWndProc, cbClsExtra, cbWndExtra,
 * hInstance, hIcon, hCursor, hbrBackground, lpszMenuName, lpszClassName */
typedef struct {
    UINT   style;
    void  *lpfnWndProc;
    int    cbClsExtra;
    int    cbWndExtra;
    void  *hInstance;
    void  *hIcon;
    void  *hCursor;
    void  *hbrBackground;
    const uint16_t *lpszMenuName;          /* UTF-16 */
    const uint16_t *lpszClassName;         /* UTF-16 */
} ntboxd_wndclassw_t;

/*
 * Same UTF-16 -> ASCII approach as the TextOutW-family conversion:
 * map 0x00..0x7F range losslessly, everything else degrades to '?'.
 */
static void ntboxd_utf16_to_ascii(const uint16_t *src, char *dst, size_t dstsz)
{
    size_t i = 0;

    if (!dst || dstsz == 0)
        return;
    if (src) {
        while (i + 1 < dstsz && src[i]) {
            dst[i] = (src[i] < 0x80) ? (char)src[i] : '?';
            i++;
        }
    }
    dst[i] = '\0';
}

/* RegisterClassW — convert the class name, log, return a valid ATOM.
 * Matches ntboxd.c's RegisterClassA (ignores the struct, returns 1). */
DWORD __attribute__((ms_abi)) ntboxd_RegisterClassW(const ntboxd_wndclassw_t *wc)
{
    char name[256];

    if (!wc) {
        fprintf(stderr, "[stub] RegisterClassW(NULL) -> 0\n");
        return 0;
    }
    ntboxd_utf16_to_ascii(wc->lpszClassName, name, sizeof(name));
    fprintf(stderr, "[stub] RegisterClassW(\"%s\") -> 1\n", name);
    return 1; /* ATOM */
}

/* CreateWindowExW — convert className/windowName, then replicate
 * ntboxd_CreateWindowExA's window-creation logic (calloc'ed hwnd record
 * with "WIND" magic). The title pointer targets a static buffer in this
 * file, long-lived enough for the box's current window model. */
void * __attribute__((ms_abi)) ntboxd_CreateWindowExW(
    DWORD dwExStyle, LPCWSTR lpClassName, LPCWSTR lpWindowName,
    DWORD dwStyle, int x, int y, int nWidth, int nHeight,
    void *hWndParent, void *hMenu, void *hInstance, LPVOID lpParam)
{
    char cls[256], title[256];
    ntboxd_hwnd_w_t *win;

    (void)dwExStyle; (void)dwStyle; (void)x; (void)y;
    (void)hWndParent; (void)hMenu; (void)hInstance; (void)lpParam;

    ntboxd_utf16_to_ascii(lpClassName, cls, sizeof(cls));
    ntboxd_utf16_to_ascii(lpWindowName, title, sizeof(title));

    win = calloc(1, sizeof(*win));
    if (!win)
        return NULL;
    win->magic  = NTBOXD_HWND_MAGIC_W;
    win->width  = nWidth  > 0 ? nWidth  : 640;
    win->height = nHeight > 0 ? nHeight : 480;
    win->title  = title[0] ? title : "NT-Box Window";
    win->shown  = 0;
    fprintf(stderr, "[stub] CreateWindowExW: '%s' '%s' %dx%d\n",
            cls, win->title, win->width, win->height);
    return (void *)win;
}

/* DefWindowProcW — matches DefWindowProcA: no-op, returns 0. */
LONG_PTR __attribute__((ms_abi)) ntboxd_DefWindowProcW(
    void *hwnd, UINT msg, UINT_PTR wParam, LONG_PTR lParam)
{
    (void)hwnd; (void)msg; (void)wParam; (void)lParam;
    fprintf(stderr, "[stub] DefWindowProcW(hwnd=%p, msg=0x%x)\n", hwnd, msg);
    return 0;
}

/* MessageBoxW — convert text/caption to ASCII and log like MessageBoxA. */
DWORD __attribute__((ms_abi)) ntboxd_MessageBoxW(
    void *hWnd, LPCWSTR lpText, LPCWSTR lpCaption, UINT uType)
{
    char text[256], caption[256];

    (void)hWnd; (void)uType;
    ntboxd_utf16_to_ascii(lpText, text, sizeof(text));
    ntboxd_utf16_to_ascii(lpCaption, caption, sizeof(caption));
    fprintf(stderr, "[stub] MessageBoxW: %s%s%s\n",
            caption, caption[0] ? " - " : "", text);
    return 1; /* IDOK */
}

/* ====================================================================
 * MSVCRT CRT-CRITICAL STUBS (real behavior so MinGW CRT startup survives)
 * ====================================================================
 * WIRING NOTE (owner: ntboxd.c resolve() + ntboxd_libc.c table,
 * parallel agent): every function here is exported under the
 * ntboxd_msvcrt_* convention AND — where the msvcrt export name starts
 * with an underscore — under a bare-name alias ntboxd_<msvcrt-name>
 * (e.g. ntboxd__initterm) via assembler .set aliases, so wiring code can
 * use whichever name it prefers.
 */

#define NTBOXD_CRT_ALIAS(alias, real) \
    __asm__(".globl " #alias "\n\t.set " #alias ", " #real)

/* _onexit — return the passed pointer (nonzero) so CRT thinks it's ok */
void * __attribute__((ms_abi)) ntboxd_msvcrt_onexit(void *func)
{
    fprintf(stderr, "[stub] msvcrt._onexit(%p) -> %p\n", func, func);
    return func;
}

/* __dllonexit — return the function pointer (first arg) */
void * __attribute__((ms_abi)) ntboxd_msvcrt_dllonexit(
    void *func, void **pdata, void **ptdata)
{
    (void)pdata; (void)ptdata;
    fprintf(stderr, "[stub] msvcrt.__dllonexit(%p) -> %p\n", func, func);
    return func;
}

/* _cexit — log and return (process stays alive in the box) */
void __attribute__((ms_abi)) ntboxd_msvcrt_cexit(void)
{
    fprintf(stderr, "[stub] msvcrt._cexit() -> void\n");
}

/* __setusermatherr — log and return (void) */
void __attribute__((ms_abi)) ntboxd_msvcrt_setusermatherr(void *handler)
{
    fprintf(stderr, "[stub] msvcrt.__setusermatherr(%p)\n", handler);
}

/* __set_app_type — log and return (void) */
void __attribute__((ms_abi)) ntboxd_msvcrt_set_app_type(int app_type)
{
    fprintf(stderr, "[stub] msvcrt.__set_app_type(%d)\n", app_type);
}

/* _fpreset — log and return (void) */
void __attribute__((ms_abi)) ntboxd_msvcrt_fpreset(void)
{
    fprintf(stderr, "[stub] msvcrt._fpreset()\n");
}

/* abort — log then terminate (wired or not, guest asked to die) */
void __attribute__((ms_abi)) ntboxd_msvcrt_abort(void)
{
    fprintf(stderr, "[stub] msvcrt.abort() -> terminating 0x133\n");
    fflush(stderr);
    exit(0x133);
}

/* exit — proper termination with the guest exit code (truncated to 8 bits) */
void __attribute__((ms_abi)) ntboxd_msvcrt_exit(int code)
{
    fprintf(stderr, "[stub] msvcrt.exit(%d/%d)\n", code, code & 0xff);
    fflush(stdout);
    fflush(stderr);
    exit(code & 0xff);
}

/* signal — accept registration, return no previous handler */
void * __attribute__((ms_abi)) ntboxd_msvcrt_signal(int sig, void *handler)
{
    fprintf(stderr, "[stub] msvcrt.signal(%d, %p) -> NULL\n", sig, handler);
    return NULL;
}

/* strerror — host glibc lookup, always a valid string */
char * __attribute__((ms_abi)) ntboxd_msvcrt_strerror(int errnum)
{
    fprintf(stderr, "[stub] msvcrt.strerror(%d)\n", errnum);
    return errnum == 0 ? (char *)"Success" : strerror(errnum);
}

/* localeconv — static, zero-initialized "C" locale */
struct lconv * __attribute__((ms_abi)) ntboxd_msvcrt_localeconv(void)
{
    static struct lconv lc;
    static int initialized = 0;

    if (!initialized) {
        memset(&lc, 0, sizeof(lc));
        lc.decimal_point   = (char *)".";
        lc.thousands_sep   = (char *)"";
        lc.grouping        = (char *)"";
        lc.mon_decimal_point = (char *)".";
        lc.int_curr_symbol = (char *)"";
        lc.currency_symbol = (char *)"";
        lc.mon_grouping    = (char *)"";
        lc.positive_sign   = (char *)"";
        lc.negative_sign   = (char *)"-";
        initialized = 1;
    }
    fprintf(stderr, "[stub] msvcrt.localeconv() -> %p\n", (void *)&lc);
    return &lc;
}

/* fwrite — cannot safely translate guest FILE*: report size*count.
 * Wired code owner note: if a guest-stdout mapping ever exists,
 * forward to host stdio then (see ntboxd_libc.c fputs/printf pattern). */
size_t __attribute__((ms_abi)) ntboxd_msvcrt_fwrite(
    const void *ptr, size_t size, size_t count, void *stream)
{
    fprintf(stderr, "[stub] msvcrt.fwrite(%p, %zu x %zu, stream=%p) -> %zu\n",
            ptr, size, count, stream, stream ? size * count : 0);
    return stream ? size * count : 0;
}

/* fputc — echo the char like stdio (hack), return the char */
int __attribute__((ms_abi)) ntboxd_msvcrt_fputc(int c, void *stream)
{
    fprintf(stderr, "[stub] msvcrt.fputc(0x%x, stream=%p) -> %d\n", c, stream, c);
    return c;
}

/* fprintf — guest FILE* cannot be dereferenced; log the format string
 * (read-only, mapped guest memory) and claim success count. Win64 ABI
 * lets a fixed-arity function receive variadic args, extra args ignored. */
int __attribute__((ms_abi)) ntboxd_msvcrt_fprintf(void *stream, const char *fmt)
{
    fprintf(stderr, "[stub] msvcrt.fprintf(stream=%p, fmt=\"%s\") -> %zu\n",
            stream, fmt ? fmt : "(null)", fmt ? strlen(fmt) : 0);
    return fmt ? (int)strlen(fmt) : 0;
}

/* _errno — pointer to a static int */
int * __attribute__((ms_abi)) ntboxd_msvcrt_errno(void)
{
    static int g_errno;
    fprintf(stderr, "[stub] msvcrt._errno() -> %p\n", (void *)&g_errno);
    return &g_errno;
}

/* _commode / _fmode — static zeroed ints (these are DATA-ish imports;
 * MinGW CRT dereferences them, so a real writable int is mandatory. */
int * __attribute__((ms_abi)) ntboxd_msvcrt_commode(void)
{
    static int g_commode;
    fprintf(stderr, "[stub] msvcrt._commode() -> %p\n", (void *)&g_commode);
    return &g_commode;
}

int * __attribute__((ms_abi)) ntboxd_msvcrt_fmode(void)
{
    static int g_fmode;
    fprintf(stderr, "[stub] msvcrt._fmode() -> %p\n", (void *)&g_fmode);
    return &g_fmode;
}

/* Bare-name assembler aliases (ntboxd_<msvcrt-export-name>) for wiring
 * from ntboxd.c resolve()/ntboxd_libc.c table without extra glue. */
NTBOXD_CRT_ALIAS(ntboxd__initterm,          ntboxd_msvcrt_initterm);
NTBOXD_CRT_ALIAS(ntboxd__onexit,            ntboxd_msvcrt_onexit);
NTBOXD_CRT_ALIAS(ntboxd___dllonexit,        ntboxd_msvcrt_dllonexit);
NTBOXD_CRT_ALIAS(ntboxd__cexit,             ntboxd_msvcrt_cexit);
NTBOXD_CRT_ALIAS(ntboxd__amsg_exit,         ntboxd_msvcrt_amsg_exit);
NTBOXD_CRT_ALIAS(ntboxd___setusermatherr,   ntboxd_msvcrt_setusermatherr);
NTBOXD_CRT_ALIAS(ntboxd___set_app_type,     ntboxd_msvcrt_set_app_type);
NTBOXD_CRT_ALIAS(ntboxd__fpreset,           ntboxd_msvcrt_fpreset);
NTBOXD_CRT_ALIAS(ntboxd_abort,              ntboxd_msvcrt_abort);
NTBOXD_CRT_ALIAS(ntboxd_exit,               ntboxd_msvcrt_exit);
NTBOXD_CRT_ALIAS(ntboxd_signal,             ntboxd_msvcrt_signal);
NTBOXD_CRT_ALIAS(ntboxd_strerror,           ntboxd_msvcrt_strerror);
NTBOXD_CRT_ALIAS(ntboxd_localeconv,         ntboxd_msvcrt_localeconv);
NTBOXD_CRT_ALIAS(ntboxd_fwrite,             ntboxd_msvcrt_fwrite);
NTBOXD_CRT_ALIAS(ntboxd_fputc,              ntboxd_msvcrt_fputc);
NTBOXD_CRT_ALIAS(ntboxd_fprintf,            ntboxd_msvcrt_fprintf);
NTBOXD_CRT_ALIAS(ntboxd__errno,             ntboxd_msvcrt_errno);
NTBOXD_CRT_ALIAS(ntboxd__commode,           ntboxd_msvcrt_commode);
NTBOXD_CRT_ALIAS(ntboxd__fmode,             ntboxd_msvcrt_fmode);


