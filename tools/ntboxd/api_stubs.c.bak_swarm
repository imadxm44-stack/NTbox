/* ====================================================================
 * STRING CONVERSION
 * ==================================================================== */

/* MultiByteToWideChar — minimal stub */
int __attribute__((ms_abi)) ntboxd_MultiByteToWideChar(
    UINT CodePage,
    DWORD dwFlags,
    LPCSTR lpMultiByteStr,
    int cbMultiByte,
    LPWSTR lpWideCharStr,
    int cchWideChar)
{
    int len = lpMultiByteStr ? strlen(lpMultiByteStr) : 0;
    if (cbMultiByte > 0)
        len = cbMultiByte;
    fprintf(stderr, "[stub] MultiByteToWideChar(cp=%u, ..., len=%d) -> %d\n",
            CodePage, cbMultiByte, len);
    if (lpWideCharStr && cchWideChar > len) {
        for (int i = 0; i < len; i++)
            lpWideCharStr[i] = (WORD)(unsigned char)lpMultiByteStr[i];
        lpWideCharStr[len] = 0;
    }
    return len;
}

/* WideCharToMultiByte — minimal stub */
int __attribute__((ms_abi)) ntboxd_WideCharToMultiByte(
    UINT CodePage,
    DWORD dwFlags,
    LPCWSTR lpWideCharStr,
    int cchWideChar,
    LPSTR lpMultiByteStr,
    int cbMultiByte,
    LPCSTR lpDefaultChar,
    unsigned char *lpUsedDefaultChar)
{
    int len = 0;
    if (lpWideCharStr) {
        while (lpWideCharStr[len] && len < cchWideChar)
            len++;
    }
    fprintf(stderr, "[stub] WideCharToMultiByte(cp=%u, ..., len=%d) -> %d\n",
            CodePage, cchWideChar, len);
    if (lpMultiByteStr && cbMultiByte > len) {
        for (int i = 0; i < len; i++)
            lpMultiByteStr[i] = (char)(lpWideCharStr[i] & 0xFF);
        lpMultiByteStr[len] = 0;
    }
    return len;
}

/* ====================================================================
 * SYSTEM INFORMATION
 * ==================================================================== */

/* GetTickCount — return milliseconds since boot */
DWORD __attribute__((ms_abi)) ntboxd_GetTickCount(void)
{
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    DWORD tick = (DWORD)((ts.tv_sec * 1000) + (ts.tv_nsec / 1000000));
    fprintf(stderr, "[stub] GetTickCount() -> %u\n", tick);
    return tick;
}

/* GetSystemTimeAsFileTime — return current FILETIME */
void __attribute__((ms_abi)) ntboxd_GetSystemTimeAsFileTime(ULONGLONG *lpSystemTimeAsFileTime)
{
    struct timespec ts;
    clock_gettime(CLOCK_REALTIME, &ts);
    /* FILETIME = 100-nanosecond intervals since 1601-01-01 */
    ULONGLONG filetime = (ts.tv_sec + 11644473600LL) * 10000000LL + (ts.tv_nsec / 100);
    fprintf(stderr, "[stub] GetSystemTimeAsFileTime(%p) -> 0x%llx\n",
            lpSystemTimeAsFileTime, (unsigned long long)filetime);
    if (lpSystemTimeAsFileTime)
        *lpSystemTimeAsFileTime = filetime;
}

/* QueryPerformanceCounter — return high-resolution counter */
BOOL __attribute__((ms_abi)) ntboxd_QueryPerformanceCounter(ULONGLONG *lpPerformanceCount)
{
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    ULONGLONG counter = ts.tv_sec * 1000000000LL + ts.tv_nsec;
    fprintf(stderr, "[stub] QueryPerformanceCounter(%p) -> 0x%llx\n",
            lpPerformanceCount, (unsigned long long)counter);
    if (lpPerformanceCount)
        *lpPerformanceCount = counter;
    return 1;
}

/* QueryPerformanceFrequency — return frequency */
BOOL __attribute__((ms_abi)) ntboxd_QueryPerformanceFrequency(ULONGLONG *lpFrequency)
{
    fprintf(stderr, "[stub] QueryPerformanceFrequency(%p) -> 1000000000 (1GHz)\n", lpFrequency);
    if (lpFrequency)
        *lpFrequency = 1000000000LL;  /* 1 GHz */
    return 1;
}

/* GetSystemInfo — fill in SYSTEM_INFO structure */
void __attribute__((ms_abi)) ntboxd_GetSystemInfo(PVOID lpSystemInfo)
{
    fprintf(stderr, "[stub] GetSystemInfo(%p)\n", lpSystemInfo);
    /* SYSTEM_INFO structure (36 bytes on x86, 48 on x64) */
    if (lpSystemInfo) {
        memset(lpSystemInfo, 0, 48);
        *(DWORD *)((char *)lpSystemInfo + 0) = 9;   /* dwOemId */
        *(DWORD *)((char *)lpSystemInfo + 4) = 4096; /* dwPageSize */
        *(DWORD *)((char *)lpSystemInfo + 8) = (DWORD)(uintptr_t)0x10000; /* lpMinimumApplicationAddress */
        *(DWORD *)((char *)lpSystemInfo + 12) = 0x7FFEFFFF; /* lpMaximumApplicationAddress */
        *(DWORD *)((char *)lpSystemInfo + 16) = 0; /* dwActiveProcessorMask */
        *(DWORD *)((char *)lpSystemInfo + 20) = 4;  /* dwNumberOfProcessors */
        *(WORD *)((char *)lpSystemInfo + 24) = 0; /* wProcessorArchitecture */
        *(WORD *)((char *)lpSystemInfo + 26) = 0; /* wReserved */
        *(DWORD *)((char *)lpSystemInfo + 28) = 0x1000; /* dwAllocationGranularity */
        *(WORD *)((char *)lpSystemInfo + 32) = 6; /* wProcessorLevel */
        *(WORD *)((char *)lpSystemInfo + 34) = 1; /* wProcessorRevision */
    }
}

/* GetLocalTime — return current time */
void __attribute__((ms_abi)) ntboxd_GetLocalTime(PVOID lpSystemTime)
{
    fprintf(stderr, "[stub] GetLocalTime(%p)\n", lpSystemTime);
    /* SYSTEMTIME: Year, Month, DayOfWeek, Day, Hour, Minute, Second, Milliseconds (16 bytes) */
    if (lpSystemTime) {
        memset(lpSystemTime, 0, 16);
        time_t now = time(NULL);
        struct tm *tm = localtime(&now);
        *(WORD *)((char *)lpSystemTime + 0) = tm->tm_year + 1900;   /* Year */
        *(WORD *)((char *)lpSystemTime + 2) = tm->tm_mon + 1;       /* Month */
        *(WORD *)((char *)lpSystemTime + 4) = tm->tm_wday;          /* DayOfWeek */
        *(WORD *)((char *)lpSystemTime + 6) = tm->tm_mday;          /* Day */
        *(WORD *)((char *)lpSystemTime + 8) = tm->tm_hour;          /* Hour */
        *(WORD *)((char *)lpSystemTime + 10) = tm->tm_min;          /* Minute */
        *(WORD *)((char *)lpSystemTime + 12) = tm->tm_sec;          /* Second */
        *(WORD *)((char *)lpSystemTime + 14) = 0;                  /* Milliseconds */
    }
}

/* SetLocalTime — log and return success */
BOOL __attribute__((ms_abi)) ntboxd_SetLocalTime(const PVOID lpSystemTime)
{
    fprintf(stderr, "[stub] SetLocalTime(%p)\n", lpSystemTime);
    return 1;
}

/* GetVersionExA — return Windows 7 version info */
BOOL __attribute__((ms_abi)) ntboxd_GetVersionExA(PVOID lpVersionInformation)
{
    fprintf(stderr, "[stub] GetVersionExA(%p) -> Windows 7\n", lpVersionInformation);
    if (lpVersionInformation) {
        memset(lpVersionInformation, 0, 148);  /* OSVERSIONINFOEXA size */
        *(DWORD *)((char *)lpVersionInformation + 0) = 148;   /* dwOSVersionInfoSize */
        *(DWORD *)((char *)lpVersionInformation + 4) = 6;     /* dwMajorVersion */
        *(DWORD *)((char *)lpVersionInformation + 8) = 1;     /* dwMinorVersion */
        *(DWORD *)((char *)lpVersionInformation + 12) = 7600; /* dwBuildNumber */
        *(DWORD *)((char *)lpVersionInformation + 16) = 2;    /* dwPlatformId (VER_PLATFORM_WIN32_NT) */
    }
    return 1;
}

/* GetVersionExW — stub version */
BOOL __attribute__((ms_abi)) ntboxd_GetVersionExW(PVOID lpVersionInformation)
{
    fprintf(stderr, "[stub] GetVersionExW(...) -> Windows 7\n");
    if (lpVersionInformation) {
        memset(lpVersionInformation, 0, 284);  /* OSVERSIONINFOEXW larger */
        *(DWORD *)((char *)lpVersionInformation + 0) = 284;
        *(DWORD *)((char *)lpVersionInformation + 4) = 6;
        *(DWORD *)((char *)lpVersionInformation + 8) = 1;
        *(DWORD *)((char *)lpVersionInformation + 12) = 7600;
        *(DWORD *)((char *)lpVersionInformation + 16) = 2;
    }
    return 1;
}

/* GetStartupInfoA/W */
