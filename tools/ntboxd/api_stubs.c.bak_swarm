/* GetCurrentThreadId — return thread ID */
DWORD __attribute__((ms_abi)) ntboxd_GetCurrentThreadId(void)
{
    DWORD tid = (DWORD)gettid();
    if (tid == 0) tid = (DWORD)pthread_self();
    fprintf(stderr, "[stub] GetCurrentThreadId() -> 0x%x\n", tid);
    return tid;
}

/* GetExitCodeThread — always return success */
BOOL __attribute__((ms_abi)) ntboxd_GetExitCodeThread(HANDLE hThread, DWORD *lpExitCode)
{
    fprintf(stderr, "[stub] GetExitCodeThread(%p, %p)\n", hThread, lpExitCode);
    if (lpExitCode)
        *lpExitCode = 0;
    return 1;
}

/* ExitThread — log and exit current thread */
DWORD __attribute__((ms_abi)) ntboxd_ExitThread(DWORD dwExitCode)
{
    fprintf(stderr, "[stub] ExitThread(%u)\n", dwExitCode);
    pthread_exit(NULL);
    return dwExitCode;
}

