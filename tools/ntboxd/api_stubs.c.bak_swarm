__attribute__((ms_abi)) int ntboxd_api_GetMessageA(void *m, void *hwnd, unsigned int fmin, unsigned int fmax) { extern int ntboxd_GetMessageA(void*,void*,unsigned int,unsigned int); return ntboxd_GetMessageA(m,hwnd,fmin,fmax); }
