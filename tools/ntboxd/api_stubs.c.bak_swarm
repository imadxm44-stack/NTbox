/* ====================================================================
 * INTERLOCKED OPERATIONS
 * ==================================================================== */

/* InterlockedIncrement — atomic increment */
LONG __attribute__((ms_abi)) ntboxd_InterlockedIncrement(LONG *lpAddend)
{
    if (lpAddend) {
        (*lpAddend)++;
        fprintf(stderr, "[stub] InterlockedIncrement(%p) -> %d\n", lpAddend, *lpAddend);
        return *lpAddend;
    }
    return 0;
}

/* InterlockedDecrement — atomic decrement */
LONG __attribute__((ms_abi)) ntboxd_InterlockedDecrement(LONG *lpAddend)
{
    if (lpAddend) {
        (*lpAddend)--;
        fprintf(stderr, "[stub] InterlockedDecrement(%p) -> %d\n", lpAddend, *lpAddend);
        return *lpAddend;
    }
    return 0;
}

/* InterlockedExchange — atomic exchange */
LONG __attribute__((ms_abi)) ntboxd_InterlockedExchange(LONG *Target, LONG Value)
{
    LONG old = 0;
    if (Target) {
        old = *Target;
        *Target = Value;
    }
    fprintf(stderr, "[stub] InterlockedExchange(%p, %d) -> %d\n", Target, Value, old);
    return old;
}

/* InterlockedCompareExchange — atomic compare-and-swap */
LONG __attribute__((ms_abi)) ntboxd_InterlockedCompareExchange(
    LONG *Destination,
    LONG Exchange,
    LONG Comperand)
{
    LONG old = 0;
    if (Destination) {
        old = *Destination;
        if (old == Comperand)
            *Destination = Exchange;
    }
    fprintf(stderr, "[stub] InterlockedCompareExchange(%p, %d, %d) -> %d\n",
            Destination, Exchange, Comperand, old);
    return old;
}

/* InterlockedCompareExchange64 — 64-bit atomic CAS */
uint64_t __attribute__((ms_abi)) ntboxd_InterlockedCompareExchange64(
    uint64_t *Destination,
    uint64_t Exchange,
    uint64_t Comperand)
{
    uint64_t old = 0;
    if (Destination) {
        old = *Destination;
        if (old == Comperand)
            *Destination = Exchange;
    }
    fprintf(stderr, "[stub] InterlockedCompareExchange64(%p, 0x%llx, 0x%llx) -> 0x%llx\n",
            Destination, (unsigned long long)Exchange, (unsigned long long)Comperand,
            (unsigned long long)old);
    return old;
}

