/* GetCurrentDirectoryA — return "C:\\" */
DWORD __attribute__((ms_abi)) ntboxd_GetCurrentDirectoryA(
    DWORD nBufferLength,
    LPSTR lpBuffer)
{
    const char *cwd = "C:\\";
    size_t len = strlen(cwd);
    fprintf(stderr, "[stub] GetCurrentDirectoryA(%u, %p) -> \"%s\"\n",
            nBufferLength, lpBuffer, cwd);
    if (lpBuffer && nBufferLength > len)
        strcpy(lpBuffer, cwd);
    return (DWORD)(len + 1);
}

