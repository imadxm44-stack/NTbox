/* ====================================================================
 * FLS (Fiber Local Storage) - common in modern apps
 * ==================================================================== */
static DWORD g_fls_slots[128];
static BOOL g_fls_used[128];

DWORD __attribute__((ms_abi)) ntboxd_FlsAlloc(void *lpCallback)
{
    (void)lpCallback;
    for (int i = 0; i < 128; i++) {
        if (!g_fls_used[i]) {
            g_fls_used[i] = TRUE;
            fprintf(stderr, "[stub] FlsAlloc() -> %d\n", i);
            return i;
        }
    }
    return 0xFFFFFFFF; /* FLS_OUT_OF_INDEXES */
}

PVOID __attribute__((ms_abi)) ntboxd_FlsGetValue(DWORD dwFlsIndex)
{
    fprintf(stderr, "[stub] FlsGetValue(%u)\n", dwFlsIndex);
    if (dwFlsIndex < 128 && g_fls_used[dwFlsIndex])
        return (PVOID)(uintptr_t)g_fls_slots[dwFlsIndex];
    return NULL;
}

BOOL __attribute__((ms_abi)) ntboxd_FlsSetValue(DWORD dwFlsIndex, PVOID lpFlsData)
{
    fprintf(stderr, "[stub] FlsSetValue(%u, %p)\n", dwFlsIndex, lpFlsData);
    if (dwFlsIndex >= 128) return FALSE;
    g_fls_used[dwFlsIndex] = TRUE;
    g_fls_slots[dwFlsIndex] = (DWORD)(uintptr_t)lpFlsData;
    return TRUE;
}

BOOL __attribute__((ms_abi)) ntboxd_FlsFree(DWORD dwFlsIndex)
{
    fprintf(stderr, "[stub] FlsFree(%u)\n", dwFlsIndex);
    if (dwFlsIndex >= 128) return FALSE;
    g_fls_used[dwFlsIndex] = FALSE;
    return TRUE;
}

